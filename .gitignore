# =============================================================================
# datapipeline — .gitignore
# =============================================================================

# ── Environment & secrets ─────────────────────────────────────────────────────
# .env is generated by install.sh from ~/.airflow with real server credentials.
# The safe placeholder template lives in .env.template (tracked).
.env
.env.local
.dev_env
.prod_env
*.env.local
.airflow
.server_airflow_env
*_airflow_env
CREDS.md
# Docker secret files — created by `make init-secrets` from ~/.airflow
secrets/

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# ── Web UI runtime files ──────────────────────────────────────────────────────
web_ui/webui.db

# ── Data files ────────────────────────────────────────────────────────────────
# Ignore the whole data_dumps tree except directory skeleton placeholders
data_dumps/**
!data_dumps/
!data_dumps/incoming/
!data_dumps/incoming/.gitkeep
!data_dumps/archive/
!data_dumps/archive/.gitkeep
*.csv
*.parquet

# ── Data pipeline monitor runtime data ───────────────────────────────────────
# Files written here by the monitor at runtime must not be tracked on servers.
data_pipeline_monitor/data/*
!data_pipeline_monitor/data/.gitkeep

# ── Generated at runtime by the Web UI — never commit these ──────────────────
# Config JSONs, DAG .py files, SQL files (all live in customer subfolders)
dags/config/*/
dags/sql/*/
dags/etl/*/

# ── Data dump folders (incoming files, archives, processed data) ──────────────
# (covered by data_dumps/** above; skeleton .gitkeep files are explicitly un-ignored)

# ── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE files ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Docker ───────────────────────────────────────────────────────────────────
# .env is committed as a template (safe — contains only ${VAR} placeholders)
# Real values live in ~/.airflow on each server
