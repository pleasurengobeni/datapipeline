# Tasks
# ─────────────────────────────────────────────────────────────────────────────

def sense_file_fn(**ctx) -> bool:
    """
    PythonSensor poke: check watch_path for the exact file_name.
    Pushes matched file path to XCom so downstream tasks can use it.
    Returns True (sensor success) when the file is found.
    """
    src         = CONFIG["source"]
    watch_path  = src["watch_path"]
    file_name   = src["file_name"]

    matched = _find_file(watch_path, file_name)
    if matched:
        ctx["ti"].xcom_push(key="matched_file", value=matched)
        logging.info(f"[sense_file] Found: {matched}")
        return True

    logging.info(f"[sense_file] '{file_name}' not yet in '{watch_path}' — will retry.")
    return False


def compute_checksum(**ctx):
    """Compute MD5 of the matched file and push to XCom."""
    file_path = ctx["ti"].xcom_pull(task_ids="sense_file", key="matched_file")
    if not file_path or not os.path.exists(file_path):
        raise FileNotFoundError(f"[compute_checksum] File not found: {file_path}")

    checksum = _compute_md5(file_path)
    file_size = os.path.getsize(file_path)
    logging.info(f"[compute_checksum] {file_path} | MD5={checksum} | size={file_size}")
    ctx["ti"].xcom_push(key="checksum",  value=checksum)
    ctx["ti"].xcom_push(key="file_size", value=file_size)


def check_registry(**ctx):
    """Branch: skip if checksum already registered, otherwise ingest into raw.

    Keyed on raw's schema/table (not target's) — raw is the durable
    ingest checkpoint now, so "have I already loaded this file" means
    "is it already in raw," matching the hybrid pipeline's convention.
    """
    raw      = CONFIG["raw"]
    checksum = ctx["ti"].xcom_pull(task_ids="compute_checksum", key="checksum")

    if _checksum_already_registered(raw["schema"], raw["table"], checksum):
        logging.info(f"[check_registry] Checksum {checksum} already loaded — skipping.")
        return "already_loaded"
    return "load_to_raw"


def load_to_raw(**ctx):
    """Read the file and append it as-is (TEXT-only, no casts/transforms)
    into the permanent raw table. Raw is never truncated — it accumulates
    as a durable record of everything ever ingested, so target can always
    be rebuilt from it without re-requesting the original file.
    """
    from sqlalchemy import text

    ti     = ctx["ti"]
    src    = CONFIG["source"]
    raw    = CONFIG["raw"]
    run_id = ctx.get("run_id", ctx["dag_run"].run_id)

    file_path = ti.xcom_pull(task_ids="sense_file", key="matched_file")
    checksum  = ti.xcom_pull(task_ids="compute_checksum", key="checksum")
    file_name = Path(file_path).name

    df = _read_file(src, file_path)
    logging.info(f"[load_to_raw] Read {len(df)} rows, {len(df.columns)} columns from '{file_name}'")

    # Raw is a landing zone — no type coercion, no transformations. Those
    # are applied downstream in load_to_target so raw always reflects
    # exactly what was ingested.
    now = datetime.utcnow()
    df = df.drop(columns=[c for c in _ALL_META_COLS if c in df.columns])
    data_cols = list(df.columns)
    df["_row_checksum"] = (
        df[data_cols].astype(str)
        .apply(lambda r: hashlib.md5("|".join(r).encode("utf-8")).hexdigest(), axis=1)
    )
    df.insert(0, "_pipeline_inserted_at", now)
    df.insert(1, "_pipeline_run_id",      run_id)
    df.insert(2, "_source_file",          file_name)
    df.insert(3, "_file_checksum",        checksum)
    df.insert(4, "_loaded_at",            now)

    engine = _get_target_engine()
    with engine.begin() as conn:
        conn.execute(text(f'CREATE SCHEMA IF NOT EXISTS "{raw["schema"]}"'))
        conn.execute(text('CREATE SCHEMA IF NOT EXISTS "etl_stg"'))
    _ensure_table_from_df(df, raw["schema"], raw["table"])

    # Row-level dedup matched on data + provenance (_row_checksum AND
    # _file_checksum), not data alone — the same row appearing again in a
    # genuinely different file is a real, distinct ingest event worth
    # keeping in this permanent record, not something to silently drop.
    # Data-only dedup belongs downstream at the target instead.
    tmp = f"_tmp_raw_{hashlib.md5(run_id.encode()).hexdigest()[:8]}"
    df.head(0).to_sql(tmp, schema="etl_stg", con=engine, if_exists="replace", index=False)
    _pg_copy_df(df, "etl_stg", tmp, engine)

    cols = ", ".join(f'"{c}"' for c in df.columns)
    with engine.begin() as conn:
        result = conn.execute(text(f"""
            INSERT INTO "{raw["schema"]}"."{raw["table"]}" ({cols})
            SELECT {cols} FROM "etl_stg"."{tmp}" t
            WHERE NOT EXISTS (
                SELECT 1 FROM "{raw["schema"]}"."{raw["table"]}" r
                WHERE r._row_checksum = t._row_checksum
                  AND r._file_checksum IS NOT DISTINCT FROM t._file_checksum
            )
        """))
        rows = result.rowcount
        conn.execute(text(f'DROP TABLE IF EXISTS "etl_stg"."{tmp}"'))

    logging.info("[load_to_raw] %d/%d rows were new (%d duplicate rows skipped) → %s.%s",
                 rows, len(df), len(df) - rows, raw["schema"], raw["table"])
    ti.xcom_push(key="rows_loaded", value=rows)
    ti.xcom_push(key="file_name",   value=file_name)


def load_to_target(**ctx):
    """Read this run's scoped batch from raw (or all of raw, on reload),
    cast/transform/checksum it, and dedup-merge it into the target table.
    """
    import numpy as np
    import pandas as pd
    from sqlalchemy import text

    ti       = ctx["ti"]
    src      = CONFIG["source"]
    tgt      = CONFIG["target"]
    raw      = CONFIG["raw"]
    schema   = tgt["target_schema"]
    table    = tgt["target_table"]
    run_id   = ctx.get("run_id", ctx["dag_run"].run_id)
    reload   = bool((ctx["dag_run"].conf or {}).get("reload"))

    # ── Read the scoped batch from raw ──────────────────────────────────
    engine = _get_target_engine()
    scope_sql = f'SELECT * FROM "{raw["schema"]}"."{raw["table"]}"'
    params = {}
    if not reload:
        scope_sql += ' WHERE "_pipeline_run_id" = :run_id'
        params = {"run_id": run_id}
    with engine.connect() as conn:
        df = pd.read_sql(text(scope_sql), conn, params=params)

    if df.empty:
        logging.info("[load_to_target] No rows in scope (reload=%s).", reload)
        ti.xcom_push(key="rows_loaded", value=0)
        ti.xcom_push(key="file_name",   value=None)
        return

    logging.info("[load_to_target] %d rows in scope from raw (reload=%s)", len(df), reload)

    # Preserve each row's real provenance instead of blanking it — matters
    # especially on reload, where rows from several different original
    # files can be in scope together at once.
    source_files    = df["_source_file"].values
    file_checksums  = df["_file_checksum"].values

    df = df.drop(columns=[c for c in _ALL_META_COLS if c in df.columns])

    # ── Apply type casts ──────────────────────────────────────────────────
    df = _cast_types(df, src)

    # ── Apply rename / transformations ────────────────────────────────────
    df = _apply_transformations(df, CONFIG)

    # ── Pipeline metadata columns ─────────────────────────────────────────
    now = datetime.utcnow()

    # Row-level checksum computed on TYPED values — must match the
    # pre-permanent-raw semantics exactly (this was always computed
    # post-cast, never off raw's TEXT values) or dedup against rows
    # already in target from before this change ships would silently break.
    data_cols = list(df.columns)
    df["_row_checksum"] = (
        df[data_cols]
        .astype(str)
        .apply(lambda r: hashlib.md5("|".join(r).encode("utf-8")).hexdigest(), axis=1)
    )

    df.insert(0, "_pipeline_inserted_at", now)
    df.insert(1, "_pipeline_run_id",      run_id)
    df.insert(2, "_source_file",          source_files)
    df.insert(3, "_file_checksum",        file_checksums)
    df.insert(4, "_loaded_at",            now)

    # ── Ensure schema + target table exist, then upsert ────────────────────
    with engine.begin() as conn:
        conn.execute(text(f'CREATE SCHEMA IF NOT EXISTS "{schema}"'))
        conn.execute(text("CREATE SCHEMA IF NOT EXISTS etl_stg"))

    # ── Reconcile metadata columns on pre-existing tables ────────────────
    # A table can be written to by any pipeline_type over its lifetime, so
    # every meta column any template might need must exist regardless of
    # which one created the table. If this table was previously loaded by
    # the DB pipeline it will have _source_system but lack _source_file /
    # _file_checksum.  A plain INSERT would fail with "column does not
    # exist".  We ADD whatever's missing; existing columns/data are untouched.
    _FILE_META_COLS = [
        ("_pipeline_inserted_at", "TIMESTAMP"),
        ("_pipeline_run_id",      "TEXT"),
        ("_source_system",        "TEXT"),
        ("_source_file",          "TEXT"),
        ("_file_checksum",        "TEXT"),
        ("_loaded_at",            "TIMESTAMP"),
        ("_row_checksum",         "TEXT"),
    ]
    with engine.begin() as conn:
        exists = conn.execute(text(
            "SELECT 1 FROM information_schema.tables "
            "WHERE table_schema = :s AND table_name = :t"
        ), {"s": schema, "t": table}).scalar()
        if exists:
            for col, col_type in _FILE_META_COLS:
                col_exists = conn.execute(text(
                    "SELECT 1 FROM information_schema.columns "
                    "WHERE table_schema=:s AND table_name=:t AND column_name=:c"
                ), {"s": schema, "t": table, "c": col}).scalar()
                if not col_exists:
                    conn.execute(text(
                        f'ALTER TABLE "{schema}"."{table}" ADD COLUMN "{col}" {col_type}'
                    ))
                    logging.info("[load_to_target] Added missing column %s.%s.%s (%s)", schema, table, col, col_type)
            # _source_system is a DB-pipeline column not written by file pipeline;
            # leave it in place (existing rows keep their value) but fill NULLs
            # on new rows via the INSERT — no structural change needed.

    # Write to a staging temp table in etl_stg, then insert only rows whose
    # _row_checksum is not already present in the target — prevents duplicates
    # when the same data rows appear in a subsequent file with a different checksum.
    tmp_table   = f"_tmp_{table}_{hashlib.md5(run_id.encode()).hexdigest()[:8]}"
    stg_schema  = "etl_stg"
    _is_pg      = CONFIG["target"].get("db_type", "postgresql") == "postgresql"
    _load_start = datetime.utcnow()
    logging.info("[load_to_target] Writing %d rows to staging table → %s.%s", len(df), stg_schema, tmp_table)

    if _is_pg:
        # Create empty table with correct schema, then COPY data — 5–20× faster
        df.head(0).to_sql(
            name=tmp_table,
            schema=stg_schema,
            con=engine,
            if_exists="replace",
            index=False,
        )
        _pg_copy_df(df, stg_schema, tmp_table, engine)
    else:
        df.to_sql(
            name=tmp_table,
            schema=stg_schema,
            con=engine,
            if_exists="replace",
            index=False,
            method="multi",
            chunksize=5000,
        )
    logging.info("[load_to_target] Staging table loaded in %.1fs", (datetime.utcnow() - _load_start).total_seconds())

    cols = ", ".join(f'"{c}"' for c in df.columns)
    # Auto-create the main table from the staging table structure if it doesn't exist yet
    with engine.begin() as conn:
        conn.execute(text(f"""
            CREATE TABLE IF NOT EXISTS "{schema}"."{table}" AS
            SELECT {cols} FROM "{stg_schema}"."{tmp_table}" WHERE 1=0
        """))

    with engine.begin() as conn:
        result = conn.execute(text(f"""
            INSERT INTO "{schema}"."{table}" ({cols})
            SELECT {cols} FROM "{stg_schema}"."{tmp_table}" t
            WHERE NOT EXISTS (
                SELECT 1 FROM "{schema}"."{table}" r
                WHERE r._row_checksum = t._row_checksum
            )
        """))
        rows_loaded = result.rowcount
        # Drop staging table only after successful INSERT
        conn.execute(text(f'DROP TABLE IF EXISTS "{stg_schema}"."{tmp_table}"'))
        logging.info("[load_to_target] Staging table %s.%s dropped.", stg_schema, tmp_table)

    elapsed_total = (datetime.utcnow() - _load_start).total_seconds()
    rows_skipped  = len(df) - rows_loaded
    if rows_skipped:
        logging.info("[load_to_target] Skipped %d duplicate rows (already in %s.%s)", rows_skipped, schema, table)
    logging.info(
        "[load_to_target] Inserted %d new rows → %s.%s in %.1fs (%.0f rows/s)",
        rows_loaded, schema, table, elapsed_total,
        rows_loaded / elapsed_total if elapsed_total > 0 else 0,
    )
    ti.xcom_push(key="rows_loaded", value=rows_loaded)
    # Single representative file name for metrics/registry purposes — exact
    # when this run's scope came from one file (the normal case), a summary
    # when reload pulled rows from several different original files at once.
    unique_files = sorted(set(f for f in source_files if f))
    if len(unique_files) == 1:
        ti.xcom_push(key="file_name", value=unique_files[0])
    elif unique_files:
        ti.xcom_push(key="file_name", value=f"{len(unique_files)} files (reload)")
    else:
        ti.xcom_push(key="file_name", value=None)


def discard_duplicate_file(**ctx):
    """Same-checksum file detected — already loaded previously.
    Delete it from incoming/ so sense_file stops re-triggering on it.
    """
    ti        = ctx["ti"]
    file_path = ti.xcom_pull(task_ids="sense_file", key="matched_file")

    if not file_path or not os.path.exists(file_path):
        logging.info("[discard_duplicate] File not on disk — nothing to do.")
        return

    os.remove(file_path)
    logging.info(f"[discard_duplicate] Duplicate file deleted: {file_path}")


def archive_file(**ctx):
    """Copy the loaded file to the archive folder (timestamped), then delete the original.

    Uses copy2 + os.remove instead of shutil.move so it works safely across
    different Docker volume mounts / filesystems where rename(2) would fail.
    """
    ti        = ctx["ti"]
    src       = CONFIG["source"]
    file_path = ti.xcom_pull(task_ids="sense_file", key="matched_file")

    logging.info("[archive_file] source file XCom value: %r", file_path)

    if not file_path:
        logging.warning("[archive_file] No file path in XCom — nothing to archive.")
        ti.xcom_push(key="archived_to", value=None)
        return

    if not os.path.exists(file_path):
        logging.warning("[archive_file] Source file does not exist on disk: %s", file_path)
        ti.xcom_push(key="archived_to", value=None)
        return

    archive_dir = src["archive_path"]
    logging.info("[archive_file] archive_dir resolved to: %r", archive_dir)

    try:
        os.makedirs(archive_dir, exist_ok=True)
        logging.info("[archive_file] archive_dir ensured: %s", archive_dir)
    except OSError as exc:
        logging.error("[archive_file] Cannot create archive dir %s: %s", archive_dir, exc)
        raise

    p         = Path(file_path)
    timestamp = datetime.utcnow().strftime("%Y%m%d_%H%M%S")
    new_name  = f"{p.stem}_{timestamp}{p.suffix}"
    dest      = os.path.join(archive_dir, new_name)

    logging.info("[archive_file] Copying '%s' → '%s'", file_path, dest)
    try:
        shutil.copy2(file_path, dest)
        # Reset mtime to now so cleanup_archive retention check is based on
        # when the file was archived, not the original file's mtime.
        os.utime(dest, None)
    except Exception as exc:
        logging.error("[archive_file] copy2 failed: %s", exc)
        raise

    # Verify the copy landed correctly before deleting the source
    if not os.path.exists(dest):
        raise FileNotFoundError(
            f"[archive_file] Copy appeared to succeed but dest not found: {dest}"
        )
    if os.path.getsize(dest) != os.path.getsize(file_path):
        raise ValueError(
            f"[archive_file] Size mismatch after copy: "
            f"src={os.path.getsize(file_path)} dest={os.path.getsize(dest)}"
        )

    try:
        os.remove(file_path)
        logging.info("[archive_file] Deleted original: %s", file_path)
    except OSError as exc:
        logging.warning(
            "[archive_file] Could not delete original file %s (archive copy is safe): %s",
            file_path, exc
        )
        # Don't re-raise — archive copy succeeded, original deletion is best-effort

    logging.info("[archive_file] ✅ Archived '%s' → '%s'", file_path, dest)
    ti.xcom_push(key="archived_to", value=dest)


def cleanup_archive(**ctx):
    """Delete archive files older than archive_retention_days."""
    src              = CONFIG["source"]
    archive_dir      = src["archive_path"]
    retention_days   = src["archive_retention_days"]
    cutoff           = datetime.utcnow().timestamp() - retention_days * 86400

    if not os.path.isdir(archive_dir):
        return

    deleted = 0
    for fname in os.listdir(archive_dir):
        fpath = os.path.join(archive_dir, fname)
        if os.path.isfile(fpath) and os.path.getmtime(fpath) < cutoff:
            os.remove(fpath)
            deleted += 1
            logging.info(f"[cleanup_archive] Deleted old archive file: {fpath}")

    logging.info(f"[cleanup_archive] Removed {deleted} files older than {retention_days} days.")


def collect_metrics_fn(**ctx):
    """Write run metrics to pipeline.etl_metrics and registry to pipeline.file_load_registry."""
    from sqlalchemy import create_engine, text
    from airflow.hooks.base import BaseHook

    ti          = ctx["ti"]
    dag_run     = ctx["dag_run"]
    _now        = datetime.utcnow()
    # Use dag_run.start_date — actual scheduler execution start, not logical interval start
    _start_raw  = dag_run.start_date if dag_run and dag_run.start_date else _now
    run_start   = _start_raw.replace(tzinfo=None) if hasattr(_start_raw, 'tzinfo') and _start_raw.tzinfo else _start_raw
    run_end     = _now
    duration    = int((run_end - run_start).total_seconds())
    rows_loaded = ti.xcom_pull(task_ids="load_to_target", key="rows_loaded") or 0
    file_name   = ti.xcom_pull(task_ids="load_to_target", key="file_name")   or ""
    checksum    = ti.xcom_pull(task_ids="compute_checksum", key="checksum")   or ""
    file_size   = ti.xcom_pull(task_ids="compute_checksum", key="file_size")  or 0
    file_path   = ti.xcom_pull(task_ids="sense_file",       key="matched_file") or ""
    archived_to = ti.xcom_pull(task_ids="archive_file",     key="archived_to")

    conn_id = CONFIG["target"]["target_db_conn_id"]
    conn    = BaseHook.get_connection(conn_id)
    port    = conn.port or 5432
    pwd     = quote_plus(str(conn.password or ""))
    url     = f"postgresql+psycopg2://{conn.login}:{pwd}@{conn.host}:{port}/{conn.schema}"
    engine  = create_engine(url, pool_pre_ping=True)

    schema = CONFIG["target"]["target_schema"]
    table  = CONFIG["target"]["target_table"]
    env    = Variable.get("environment", "dev")
    run_id = ctx["run_id"]

    with engine.begin() as conn:
        # ── Ensure etl_metrics table ──────────────────────────────────────
        conn.execute(text("CREATE SCHEMA IF NOT EXISTS pipeline"))
        conn.execute(text("""
            CREATE TABLE IF NOT EXISTS pipeline.etl_metrics (
                id                          SERIAL PRIMARY KEY,
                dag_id                      TEXT,
                env                         TEXT,
                schema                      TEXT,
                table_name                  TEXT,
                run_id                      TEXT,
                run_start                   TIMESTAMP WITH TIME ZONE,
                run_end                     TIMESTAMP WITH TIME ZONE,
                run_duration_secs           INTEGER,
                run_status                  TEXT NOT NULL DEFAULT 'success',
                error_msg                   TEXT,
                batch_size                  INTEGER,
                rows_loaded_now             BIGINT,
                target_total_records        BIGINT,
                target_today_records        BIGINT,
                target_max_upload_date      TIMESTAMP,
                target_first_upload_date    TIMESTAMP,
                target_max_incremental      TEXT,
                source_total_records        BIGINT,
                source_max_incremental      TEXT,
                source_loaded_to_max_target BIGINT,
                perc_loaded                 NUMERIC(6,2),
                created_at                  TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
                engine_type                 TEXT DEFAULT 'pandas',
                source_type                 TEXT DEFAULT 'db'
            )
        """))
        for m in [
            "ALTER TABLE pipeline.etl_metrics ADD COLUMN IF NOT EXISTS engine_type TEXT DEFAULT 'pandas'",
            "ALTER TABLE pipeline.etl_metrics ADD COLUMN IF NOT EXISTS source_type TEXT DEFAULT 'db'",
            "ALTER TABLE pipeline.etl_metrics ADD COLUMN IF NOT EXISTS target_today_records BIGINT",
            "ALTER TABLE pipeline.etl_metrics ADD COLUMN IF NOT EXISTS target_max_upload_date TIMESTAMP",
            "ALTER TABLE pipeline.etl_metrics ADD COLUMN IF NOT EXISTS target_first_upload_date TIMESTAMP",
            "ALTER TABLE pipeline.etl_metrics ADD COLUMN IF NOT EXISTS target_max_incremental TEXT",
            "ALTER TABLE pipeline.etl_metrics ADD COLUMN IF NOT EXISTS source_total_records BIGINT",
            "ALTER TABLE pipeline.etl_metrics ADD COLUMN IF NOT EXISTS source_max_incremental TEXT",
            "ALTER TABLE pipeline.etl_metrics ADD COLUMN IF NOT EXISTS source_loaded_to_max_target BIGINT",
            "ALTER TABLE pipeline.etl_metrics ADD COLUMN IF NOT EXISTS perc_loaded NUMERIC(6,2)",
        ]:
            conn.execute(text(m))

        # Counts plus load-recency from the target's own _loaded_at meta
        # column, which every row is stamped with at load time. A file job
        # has no incremental_column to key a "today" figure off, but "when
        # did this pipeline write the row" is always known — without this
        # the freshness columns sit NULL and the dashboard reports 0 rows
        # loaded today for a table that in fact loaded thousands.
        target_today = target_max_upload = target_first_upload = None
        try:
            conn.execute(text("SAVEPOINT count_check"))
            r = conn.execute(text(f"""
                SELECT COUNT(*),
                       COUNT(*) FILTER (WHERE "_loaded_at" >= date_trunc('day', now())),
                       MAX("_loaded_at"),
                       MIN("_loaded_at")
                FROM "{schema}"."{table}"
            """)).fetchone()
            target_total, target_today = r[0] or 0, r[1] or 0
            target_max_upload, target_first_upload = r[2], r[3]
            conn.execute(text("RELEASE SAVEPOINT count_check"))
        except Exception:
            # Target missing, or predating the pipeline meta columns.
            conn.execute(text("ROLLBACK TO SAVEPOINT count_check"))
            try:
                conn.execute(text("SAVEPOINT count_check"))
                target_total = conn.execute(
                    text(f'SELECT COUNT(*) FROM "{schema}"."{table}"')
                ).scalar() or 0
                conn.execute(text("RELEASE SAVEPOINT count_check"))
            except Exception:
                conn.execute(text("ROLLBACK TO SAVEPOINT count_check"))
                target_total = 0

        conn.execute(text("""
            INSERT INTO pipeline.etl_metrics (
                dag_id, env, schema, table_name, run_id,
                run_start, run_end, run_duration_secs, run_status,
                batch_size, rows_loaded_now, target_total_records,
                target_today_records, target_max_upload_date,
                target_first_upload_date, engine_type, source_type
            ) VALUES (
                :dag_id, :env, :schema, :table_name, :run_id,
                :run_start, :run_end, :duration, 'success',
                0, :rows_loaded, :target_total,
                :target_today, :target_max_upload,
                :target_first_upload, 'pandas', 'file'
            )
        """), {
            "dag_id":              CONFIG["dag_id"],
            "env":                 env,
            "schema":              schema,
            "table_name":          table,
            "run_id":              run_id,
            "run_start":           run_start,
            "run_end":             run_end,
            "duration":            duration,
            "rows_loaded":         rows_loaded,
            "target_total":        target_total,
            "target_today":        target_today,
            "target_max_upload":   target_max_upload,
            "target_first_upload": target_first_upload,
        })

        # ── Ensure file_load_registry and insert record ───────────────────
        # Keyed on raw's schema/table (not target's) — raw is the durable
        # ingest checkpoint, matching check_registry's scope above.
        if not checksum:
            # Reload runs bypass ingest entirely, so there's no new file/
            # checksum to register. Without this guard every reload would
            # insert a junk NULL-checksum row (Postgres treats each NULL as
            # distinct under the unique constraint, so they wouldn't even
            # dedupe against each other).
            logging.info("[collect_metrics] No new file this run (reload) — skipping registry insert.")
        else:
            raw = CONFIG["raw"]
            _ensure_registry_table(conn)
            conn.execute(text("""
                INSERT INTO pipeline.file_load_registry (
                    dag_id, target_schema, target_table, file_name, file_path,
                    file_checksum, file_size_bytes, rows_loaded, run_id,
                    loaded_at, archived_to, archived_at
                ) VALUES (
                    :dag_id, :schema, :table, :file_name, :file_path,
                    :checksum, :file_size, :rows_loaded, :run_id,
                    NOW(), :archived_to, CASE WHEN :archived_to2 IS NOT NULL THEN NOW() ELSE NULL END
                )
                ON CONFLICT (target_schema, target_table, file_checksum) DO NOTHING
            """), {
                "dag_id":      CONFIG["dag_id"],
                "schema":      raw["schema"],
                "table":       raw["table"],
                "file_name":   file_name,
                "file_path":   file_path,
                "checksum":    checksum,
                "file_size":   file_size,
                "rows_loaded": rows_loaded,
                "run_id":      run_id,
                "archived_to": archived_to,
                "archived_to2": archived_to,
            })

    logging.info(
        f"[collect_metrics] Metrics written — {rows_loaded} rows from '{file_name}' | checksum={checksum}"
    )


def collect_error_metrics_fn(**ctx):
    """Write failure metrics to pipeline.etl_metrics."""
