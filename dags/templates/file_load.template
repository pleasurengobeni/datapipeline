        conn.execute(text(
            "ALTER TABLE pipeline.etl_metrics ADD COLUMN IF NOT EXISTS source_type TEXT DEFAULT 'db'"
        ))
        conn.execute(text("""
            INSERT INTO pipeline.etl_metrics (
                dag_id, env, schema, table_name, run_id,
                run_start, run_end, run_duration_secs, run_status, error_msg,
                batch_size, rows_loaded_now, engine_type, source_type
            ) VALUES (
                :dag_id, :env, :schema, :table_name, :run_id,
                :run_start, :run_end, :duration, 'failed', :error_msg,
                0, 0, 'pandas', 'file'
            )
        """), {
            "dag_id":     CONFIG["dag_id"],
            "env":        env,
            "schema":     schema,
            "table_name": table,
            "run_id":     ctx["run_id"],
            "run_start":  run_start,
            "run_end":    run_end,
            "duration":   duration,
            "error_msg":  error_msg,
        })


# ─────────────────────────────────────────────────────────────────────────────
# DAG definition
# ─────────────────────────────────────────────────────────────────────────────

def check_reload_fn(**ctx):
    """Branch: on a reload run, skip ingest entirely and go straight to
    load_to_target (which will read ALL of raw, unscoped, instead of just
    this run's batch). A reload has no new file involved — letting the
    sensor run would block for up to 24h waiting for a file that isn't
    coming.
    """
    reload = bool((ctx["dag_run"].conf or {}).get("reload"))
    return "load_to_target" if reload else "sense_file"


default_args = {
    "owner":            "airflow",
    "depends_on_past":  False,
    "retries":          1,
    "retry_delay":      timedelta(minutes=5),
    "on_failure_callback": lambda ctx: collect_error_metrics_fn(**ctx),
}

with DAG(
    dag_id=CONFIG["dag_id"],
    default_args=default_args,
    schedule_interval=CONFIG["schedule_interval"],
    start_date=datetime.strptime(CONFIG["start_date"], "%Y-%m-%d"),
    catchup=False,
    max_active_runs=1,
    tags=CONFIG["tags"],
    params={"reload": False},
    description=(
        f"File-based ETL — pandas — "
        f"{CONFIG['source']['file_format'].upper()} → "
        f"{CONFIG['target']['target_schema']}.{CONFIG['target']['target_table']}"
    ),
) as dag:

    start = EmptyOperator(task_id="start")

    check_reload = BranchPythonOperator(
        task_id="check_reload",
        python_callable=check_reload_fn,
    )

    # ── Event-driven sensor: polls watch_path every 60s for a matching file ──
    sense = PythonSensor(
        task_id="sense_file",
        python_callable=sense_file_fn,
        poke_interval=60,          # check every 60 seconds
        timeout=86400,             # give up after 24 hours
        mode="reschedule",         # free the worker slot while waiting
        soft_fail=True,            # mark as skipped (not failed) on timeout
    )

    checksum_task = PythonOperator(
        task_id="compute_checksum",
        python_callable=compute_checksum,
    )

    registry_branch = BranchPythonOperator(
        task_id="check_registry",
        python_callable=check_registry,
    )

    already_loaded = PythonOperator(
        task_id="already_loaded",
        python_callable=discard_duplicate_file,
    )

    raw_task = PythonOperator(
        task_id="load_to_raw",
        python_callable=load_to_raw,
    )

    target_task = PythonOperator(
        task_id="load_to_target",
        python_callable=load_to_target,
        # Tolerates its ingest upstream being SKIPPED (the reload bypass
        # path) rather than succeeded (the normal path) — either way is
        # fine as long as nothing actually failed.
        trigger_rule=TriggerRule.NONE_FAILED,
    )

    archive = PythonOperator(
        task_id="archive_file",
        python_callable=archive_file,
        trigger_rule=TriggerRule.ALL_SUCCESS,  # only archive after a confirmed successful load
    )

    cleanup = PythonOperator(
        task_id="cleanup_archive",
        python_callable=cleanup_archive,
        trigger_rule=TriggerRule.ALL_SUCCESS,  # only clean up when archive step itself succeeded
    )

    metrics = PythonOperator(
        task_id="collect_metrics",
        python_callable=collect_metrics_fn,
        trigger_rule=TriggerRule.ALL_SUCCESS,
    )

    end = EmptyOperator(task_id="end", trigger_rule=TriggerRule.NONE_FAILED_MIN_ONE_SUCCESS)

    # ── Task flow ─────────────────────────────────────────────────────────
    # start → check_reload → sense_file → compute_checksum → check_registry
    #                     │                                    → load_to_raw ─┐
    #                     │                                    → already_loaded (archive + delete)
    #                     └─────────────────────────────────────────────────→ load_to_target
    #                                                                              ↓
    #                                              archive_file → cleanup_archive → collect_metrics → end

    start >> check_reload
    check_reload >> sense
    check_reload >> target_task
    sense >> checksum_task >> registry_branch
    registry_branch >> [raw_task, already_loaded]
    raw_task >> target_task
    target_task >> archive >> cleanup >> metrics >> end
    already_loaded >> end
