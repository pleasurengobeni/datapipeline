def _find_file(watch_path: str, file_name: str):  # -> Optional[str]
    """Return the full path if file_name exists in watch_path, otherwise None."""
    if not os.path.isdir(watch_path):
        return None
    fpath = os.path.join(watch_path, file_name)
    return fpath if os.path.isfile(fpath) else None


def _compute_md5(file_path: str) -> str:
    """Return MD5 hex digest of the file at file_path."""
    h = hashlib.md5()
    with open(file_path, "rb") as fh:
        for chunk in iter(lambda: fh.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def _clean_col(name: str) -> str:
    """Normalise a column name: strip accents, lower, replace non-alphanum with _."""
    # NFD decompose → strip combining marks (accents etc.)
    name = unicodedata.normalize("NFD", str(name))
    name = "".join(c for c in name if unicodedata.category(c) != "Mn")
    # lower + replace anything that isn't a-z 0-9 with _
    name = re.sub(r"[^a-z0-9]+", "_", name.lower()).strip("_")
    # protect SQL reserved words
    reserved = {"from", "select", "where", "group", "order", "having",
                "user", "table", "index", "start", "end", "begin", "if"}
    if name in reserved:
        name = name + "_"
    return name or "col"


def _detect_encoding(path: str) -> str:
    """Read a sample of the file and detect its character encoding."""
    try:
        import chardet
        with open(path, "rb") as fh:
            sample = fh.read(65536)
        result = chardet.detect(sample)
        enc = result.get("encoding") or "utf-8"
        # Normalise common aliases
        enc = enc.upper().replace("-", "")
        aliases = {"ASCII": "utf-8", "UTF8": "utf-8", "UTF8BOM": "utf-8-sig",
                   "UTF16": "utf-16", "LATIN1": "latin-1", "ISO88591": "latin-1"}
        return aliases.get(enc, result.get("encoding", "utf-8"))
    except Exception:
        return "utf-8"


def _universal_to_datetime(series: "pd.Series", hint_fmt: str = None) -> "pd.Series":
    """Parse ANY date/datetime series to datetime — DB native timestamps, ISO
    text, non-ISO text (DD/MM/YYYY, MM/DD/YYYY), epoch integers (seconds or
    milliseconds), CSV strings, named months, or mixed formats.

    hint_fmt (optional PostgreSQL-style format string, e.g. 'DD/MM/YYYY'):
        Used only to resolve DD-first vs MM-first ambiguity.  Everything else
        — time components, sub-seconds, vendor-specific text — is auto-detected.

    RAISES ValueError immediately if any non-null value cannot be parsed, with
    the offending values listed, so the Airflow task fails with an actionable
    message rather than silently writing NaT/NULL to the target table.
    """
    import pandas as pd

    # 1. Already native datetime — nothing to do
    if pd.api.types.is_datetime64_any_dtype(series):
        return series

    # 2. Determine day-first from hint
    upper = (hint_fmt or "").upper().strip()
    dayfirst = upper.startswith("DD")

    # 3. Numeric dtype (int / float) — treat directly as epoch (seconds or ms).
    #    Must happen BEFORE the pandas text parser because pandas interprets bare
    #    integers as nanosecond offsets from 1970, producing wrong dates.
    if pd.api.types.is_integer_dtype(series) or pd.api.types.is_float_dtype(series):
        unit = "ms" if (series.abs() > 2e10).any() else "s"
        parsed = pd.to_datetime(series, unit=unit, errors="coerce")
        failed_mask = parsed.isna() & series.notna()
        if failed_mask.any():
            bad = series[failed_mask].dropna().unique()[:10]
            raise ValueError(
                f"[file_load] Cannot parse {failed_mask.sum()} value(s) in column "
                f"'{series.name}' as epoch timestamp. Bad values: {list(bad)}. "
                "Check source data or add an explicit format hint in dtype_override_formats."
            )
        return parsed

    # 4. pandas mixed-format parser (handles ISO+ms/us, most text formats)
    parsed = pd.to_datetime(series, dayfirst=dayfirst, infer_datetime_format=True, errors="coerce")

    # 5. Epoch integers stored as strings (e.g. CSV column "1704067200")
    failed_mask = parsed.isna() & series.notna() & (series.astype(str).str.strip() != "")
    if failed_mask.any():
        try:
            numeric = pd.to_numeric(series[failed_mask], errors="raise")
            unit = "ms" if (numeric.abs() > 2e10).any() else "s"
            parsed = parsed.copy()
            parsed.loc[failed_mask] = pd.to_datetime(numeric, unit=unit, errors="coerce")
            failed_mask = parsed.isna() & series.notna() & (series.astype(str).str.strip() != "")
        except (ValueError, TypeError):
            pass

    # 6. dateutil fallback for named months, vendor formats, non-standard patterns
    if failed_mask.any():
        from dateutil import parser as _du
        def _try_du(v):
            try:
                return _du.parse(str(v), dayfirst=dayfirst)
            except Exception:
                return pd.NaT
        parsed = parsed.copy()
        parsed.loc[failed_mask] = series[failed_mask].apply(_try_du)
        failed_mask = parsed.isna() & series.notna() & (series.astype(str).str.strip() != "")

    # 7. Fail loudly — list the bad values so the user knows exactly what to fix
    if failed_mask.any():
        bad = series[failed_mask].dropna().unique()[:10]
        raise ValueError(
            f"[file_load] Cannot parse {failed_mask.sum()} value(s) in column "
            f"'{series.name}' as date/timestamp. Bad values: {list(bad)}. "
            "Check the source data or add an explicit format hint in dtype_override_formats."
        )
    return parsed


def _read_file(cfg: dict, file_path: str) -> "pd.DataFrame":
    """Read CSV or Parquet into a clean DataFrame with robust handling."""
    import numpy as np
    import pandas as pd

    file_format = cfg["file_format"].lower()
    null_vals   = cfg["null_values"]

    if not os.path.exists(file_path):
        raise FileNotFoundError(f"Source file not found: {file_path}")

    # ── Parquet (no encoding / ASCII issues) ──────────────────────────────
    if file_format == "parquet":
        df = pd.read_parquet(file_path)
        df.columns = [_clean_col(c) for c in df.columns]
        return df

    # ── CSV ───────────────────────────────────────────────────────────────
    encoding_cfg = cfg.get("encoding", "auto")
    encoding = _detect_encoding(file_path) if encoding_cfg == "auto" else encoding_cfg

    delimiter = cfg.get("delimiter", ",")
    has_header = cfg.get("has_header", True)
    skip_rows  = cfg.get("skip_rows", 0)

    logging.info(f"[file_load] Reading CSV: {file_path} | enc={encoding} | sep={repr(delimiter)}")

    read_kwargs = dict(
        filepath_or_buffer=file_path,
        sep=delimiter,
        header=0 if has_header else None,
        skiprows=skip_rows if skip_rows else None,
        encoding=encoding,
        encoding_errors="replace",
        na_values=null_vals,
        keep_default_na=True,
        low_memory=False,
        dtype=str,
    )

    try:
        df = pd.read_csv(**read_kwargs)
    except UnicodeDecodeError:
        logging.warning("[file_load] Encoding fallback to latin-1")
        read_kwargs["encoding"] = "latin-1"
        df = pd.read_csv(**read_kwargs)

    # ── Clean column names ────────────────────────────────────────────────
    df.columns = [_clean_col(c) for c in df.columns]

    # ── Strip whitespace from all string cells ────────────────────────────
    str_cols = df.select_dtypes(include="object").columns
    df[str_cols] = df[str_cols].apply(lambda s: s.str.strip())

    # ── Re-apply null sentinel values after strip ─────────────────────────
    null_set = {str(v).strip().lower() for v in null_vals}
    for col in str_cols:
        df[col] = df[col].where(~df[col].str.lower().isin(null_set), other=np.nan)

    # ── Remove non-printable / non-ASCII control characters ──────────────
    ctrl_re = re.compile(r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]")
    for col in str_cols:
        df[col] = df[col].apply(
            lambda x: ctrl_re.sub("", x) if isinstance(x, str) else x
        )

    return df


def _cast_types(df: "pd.DataFrame", cfg: dict) -> "pd.DataFrame":
    """Apply dtype_overrides and infer numeric/date types safely.

    dtype_overrides: {col: dtype_string} — explicit type per column.
    dtype_override_formats: {col: pg_format_string} — day/month hint for
        date/timestamp columns with non-ISO formats (e.g. 'DD/MM/YYYY').
        Follows the same PostgreSQL-style format strings as the DB pipeline.

    Date/timestamp columns run through _universal_to_datetime which handles
    any format and RAISES ValueError (fail-loud) if values cannot be parsed —
    no silent NaT/NULL in the target table.

    date_columns: legacy list of column names to cast as datetime. If a column
    also appears in dtype_overrides it is handled there; date_columns covers
    columns that only need datetime casting without a full override entry.
    """
    import pandas as pd

    date_cols        = cfg.get("date_columns", [])
    dtype_overrides  = cfg.get("dtype_overrides", {})
    fmt_hints        = cfg.get("dtype_override_formats", {})

    # ── Apply explicit overrides ──────────────────────────────────────────
    for raw_col, dtype in dtype_overrides.items():
        col = _clean_col(raw_col)
        if col not in df.columns:
            continue
        try:
            d = dtype.lower()
            if d in ("int", "int64", "integer", "bigint"):
                df[col] = pd.to_numeric(df[col], errors="coerce").astype("Int64")
            elif d in ("float", "float64", "numeric", "decimal"):
                df[col] = pd.to_numeric(df[col], errors="coerce")
            elif d in ("bool", "boolean"):
                df[col] = df[col].map(
                    {"true": True, "false": False, "1": True, "0": False,
                     "yes": True, "no": False, "y": True, "n": False}
                )
            elif d in ("date", "timestamp", "datetime"):
                hint = fmt_hints.get(raw_col) or fmt_hints.get(col)
                df[col] = _universal_to_datetime(df[col], hint_fmt=hint)
            else:
                df[col] = df[col].astype(str)
        except ValueError:
            raise  # date parse failures must bubble up — task should fail loudly
        except Exception as exc:
            logging.warning("[file_load] dtype override failed for '%s' → %s: %s", col, dtype, exc)

    # ── Explicit date_columns (legacy, no type hint available) ───────────
    already_typed = {_clean_col(c) for c in dtype_overrides}
    for raw_col in date_cols:
        col = _clean_col(raw_col)
        if col in df.columns and col not in already_typed:
            hint = fmt_hints.get(raw_col) or fmt_hints.get(col)
            df[col] = _universal_to_datetime(df[col], hint_fmt=hint)

    # ── Auto-infer numerics for remaining object columns ──────────────────
    date_col_set = {_clean_col(c) for c in date_cols}
    for col in df.select_dtypes(include="object").columns:
        if col in already_typed or col in date_col_set:
            continue
        numeric = pd.to_numeric(df[col], errors="coerce")
        # Only promote if ≥ 80 % of non-null values parsed successfully
        non_null = df[col].notna().sum()
        parsed   = numeric.notna().sum()
        if non_null > 0 and parsed / non_null >= 0.8:
            df[col] = numeric

    return df


def _apply_transformations(df: "pd.DataFrame", cfg: dict) -> "pd.DataFrame":
    """Rename columns and apply value replace_values from config."""
    rename_map = {}
    for entry in cfg.get("rename_columns", []):
        for old, new in entry.items():
            rename_map[_clean_col(old)] = _clean_col(new)
    if rename_map:
        df = df.rename(columns=rename_map)

    # transformations list: [{col: new_type}, ...]  — already handled in _cast_types
    return df


