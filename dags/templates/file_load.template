_ENGINE_CACHE = None


def _get_target_engine():
    global _ENGINE_CACHE
    if _ENGINE_CACHE is not None:
        return _ENGINE_CACHE

    from airflow.hooks.base import BaseHook
    from sqlalchemy import create_engine

    conn_id  = CONFIG["target"]["target_db_conn_id"]
    conn     = BaseHook.get_connection(conn_id)
    db_type  = CONFIG["target"].get("db_type", "postgresql")

    port = conn.port or 5432
    pwd  = quote_plus(str(conn.password or ""))
    if db_type == "mysql":
        url = f"mysql+pymysql://{conn.login}:{pwd}@{conn.host}:{port}/{conn.schema}"
    elif db_type in ("mssql", "sqlserver"):
        url = f"mssql+pyodbc://{conn.login}:{pwd}@{conn.host}:{port}/{conn.schema}?driver=ODBC+Driver+17+for+SQL+Server"
    else:
        url = f"postgresql+psycopg2://{conn.login}:{pwd}@{conn.host}:{port}/{conn.schema}"

    _ENGINE_CACHE = create_engine(url, pool_pre_ping=True)
    return _ENGINE_CACHE


def _pg_copy_df(df, schema, table, engine):
    """Bulk-load a DataFrame into a PostgreSQL table using COPY FROM STDIN.

    5–20× faster than to_sql(method='multi') for large DataFrames.
    Only called when db_type == 'postgresql'.
    """
    import io
    buf = io.StringIO()
    df.to_csv(buf, index=False, na_rep="")
    buf.seek(0)
    col_sql = ", ".join(f'"{c}"' for c in df.columns)
    raw = engine.raw_connection()
    try:
        cur = raw.cursor()
        cur.copy_expert(
            f'COPY "{schema}"."{table}" ({col_sql}) FROM STDIN WITH (FORMAT CSV, HEADER TRUE)',
            buf,
        )
        cur.close()
        raw.commit()
    finally:
        raw.close()


def _ensure_table_from_df(df, schema, table):
    """Create the raw landing table (all TEXT columns) if it doesn't exist
    yet, or add any columns present in df but missing from the table
    (handles schema evolution between runs)."""
    from sqlalchemy import text
    engine = _get_target_engine()
    col_defs = ", ".join(f'"{c}" TEXT' for c in df.columns)
    with engine.begin() as conn:
        conn.execute(text(f'CREATE TABLE IF NOT EXISTS "{schema}"."{table}" ({col_defs})'))
        for col in df.columns:
            conn.execute(text(
                f'ALTER TABLE "{schema}"."{table}" ADD COLUMN IF NOT EXISTS "{col}" TEXT'
            ))


def _checksum_already_registered(schema: str, table: str, checksum: str) -> bool:
    """Return True if this MD5 checksum is already in pipeline.file_load_registry for this target.

    Ensures the registry table exists first (idempotent) so the lookup never
    relies on exception handling — which is slow and aborts the transaction.
    """
    from sqlalchemy import text
    engine = _get_target_engine()
    with engine.begin() as conn:
        _ensure_registry_table(conn)
    with engine.connect() as conn:
        r = conn.execute(
            text("""
                SELECT 1 FROM pipeline.file_load_registry
                WHERE target_schema = :s AND target_table = :t AND file_checksum = :c
                LIMIT 1
            """),
            {"s": schema, "t": table, "c": checksum},
        )
        return r.fetchone() is not None


def _ensure_registry_table(conn):
    """Create pipeline.file_load_registry if it doesn't exist."""
    from sqlalchemy import text
    conn.execute(text("CREATE SCHEMA IF NOT EXISTS pipeline"))
    conn.execute(text("""
        CREATE TABLE IF NOT EXISTS pipeline.file_load_registry (
            id              SERIAL PRIMARY KEY,
            dag_id          TEXT,
            target_schema   TEXT,
            target_table    TEXT,
            file_name       TEXT,
            file_path       TEXT,
            file_checksum   TEXT,
            file_size_bytes BIGINT,
            rows_loaded     BIGINT,
            run_id          TEXT,
            loaded_at       TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
            archived_to     TEXT,
            archived_at     TIMESTAMP WITH TIME ZONE
        )
    """))
    conn.execute(text("""
        CREATE UNIQUE INDEX IF NOT EXISTS ux_file_registry_checksum
            ON pipeline.file_load_registry (target_schema, target_table, file_checksum)
    """))


