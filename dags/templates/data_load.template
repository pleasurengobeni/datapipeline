def _resolve_sql_path(sql_base, dag_name, sql_file=None):
    import glob
    # 1. Genuine absolute path — use as-is
    if sql_file and os.path.isabs(sql_file):
        return sql_file
    # 2. Relative path (e.g. conn_id/file.sql) — always join with sql_base
    if sql_file:
        return os.path.join(sql_base, sql_file)
    # 3. No sql_file in config — glob search for any matching file across subdirs
    matches = glob.glob(os.path.join(sql_base, "**", f"*{dag_name.lower()}*.sql"), recursive=True)
    if matches:
        return matches[0]
    # 4. Last resort fallback
    return os.path.join(sql_base, f"{dag_name.lower()}.sql")

SQL_PATH = _resolve_sql_path(SQL_BASE, dag_name, CONFIG.get("sql_file"))


def ensure_schema_exists(schema_name):
    hook = get_hook(CONFIG["target"]["target_db_conn_id"])
    engine = create_engine(hook.get_uri())
    with engine.begin() as conn:
        conn.execute(text(f"CREATE SCHEMA IF NOT EXISTS {schema_name}"))


def _ensure_pipeline_metadata_columns(schema: str, table: str):
    """ALTER TABLE to add pipeline metadata columns if they don't exist yet.
    Safe to call every run — IF NOT EXISTS is idempotent."""
    hook   = get_hook(CONFIG["target"]["target_db_conn_id"])
    engine = create_engine(hook.get_uri())
    cols = [
        ("_pipeline_inserted_at", "TIMESTAMP"),
        ("_pipeline_run_id",      "TEXT"),
        ("_source_system",        "TEXT"),
        ("_source_file",          "TEXT"),
        ("_file_checksum",        "TEXT"),
        ("_loaded_at",            "TIMESTAMP"),
        ("_row_checksum",         "TEXT"),
    ]
    with engine.begin() as conn:
        for col_name, col_type in cols:
            conn.execute(text(
                f"ALTER TABLE {schema}.{table} "
                f"ADD COLUMN IF NOT EXISTS {col_name} {col_type}"
            ))


def pandas_dtype_to_sql(dtype):
    if pd.api.types.is_integer_dtype(dtype):
        return BigInteger()
    if pd.api.types.is_float_dtype(dtype):
        return Float()
    if pd.api.types.is_bool_dtype(dtype):
        return Boolean()
    if pd.api.types.is_datetime64_any_dtype(dtype):
        return DateTime()
    # dtype.kind == 'M' covers all datetime64 variants; numpy date scalars have kind == 'O'
    # Use hasattr guard for numpy dtypes that expose .type
    if hasattr(dtype, 'type') and issubclass(dtype.type, __import__('datetime').date):
        return Date()
    return Text()


def build_sqlalchemy_dtypes(df):
    return {col: pandas_dtype_to_sql(dtype) for col, dtype in df.dtypes.items()}


def _dtype_str_to_sa_type(dtype_str: str):
    """Map a dtype_overrides string value to the equivalent SQLAlchemy column type."""
    from sqlalchemy.types import TIMESTAMP, Date as SADate
    d = dtype_str.lower()
    if d in ("int", "int64", "integer", "bigint"):
        return BigInteger()
    if d in ("float", "float64", "numeric", "decimal"):
        return Float()
    if d in ("bool", "boolean"):
        return Boolean()
    if d in ("timestamp", "datetime"):
        return TIMESTAMP()
    if d == "date":
        return SADate()
    return Text()


def _pg_fmt_to_py_fmt(pg_fmt: str) -> str:
    """Convert a PostgreSQL TO_TIMESTAMP format string to Python strptime format.
    Kept for any legacy callers; _smart_to_datetime is preferred for pandas parsing.
    """
    fmt = pg_fmt
    for tok in ("FF1", "FF2", "FF3", "FF4", "FF5", "FF6", "US", "MS"):
        fmt = fmt.replace(tok, "%f")
    return (
        fmt
        .replace("YYYY", "%Y")
        .replace("MM", "%m")
        .replace("DD", "%d")
        .replace("HH24", "%H")
        .replace("MI", "%M")
        .replace("SS", "%S")
    )


def _universal_to_datetime(series: pd.Series, hint_fmt: str = None) -> pd.Series:
    """Parse ANY date/datetime series to datetime — DB native timestamps, ISO
    text, non-ISO text (DD/MM/YYYY, MM/DD/YYYY), epoch integers (seconds or
    milliseconds), CSV strings, named months, or mixed formats.

    hint_fmt (optional PostgreSQL-style format string, e.g. 'DD/MM/YYYY'):
        Used only to resolve DD-first vs MM-first ambiguity.  Everything else
        — time components, sub-seconds, vendor-specific text — is auto-detected.

    RAISES ValueError immediately if any non-null value cannot be parsed, with
    the offending values listed, so the Airflow task fails with an actionable
    message rather than silently writing NaT/NULL to the target table.
    """
    # 1. Already native datetime — nothing to do
    if pd.api.types.is_datetime64_any_dtype(series):
        return series

    # 2. Determine day-first from hint
    upper = (hint_fmt or "").upper().strip()
    dayfirst = upper.startswith("DD")

    # 3. Numeric dtype (int / float) — treat directly as epoch (seconds or ms)
    #    Must happen BEFORE the pandas text parser because pandas interprets bare
    #    integers as nanosecond offsets from 1970, producing wrong dates.
    if pd.api.types.is_integer_dtype(series) or pd.api.types.is_float_dtype(series):
        unit = "ms" if (series.abs() > 2e10).any() else "s"
        parsed = pd.to_datetime(series, unit=unit, errors="coerce")
        failed_mask = parsed.isna() & series.notna()
        if failed_mask.any():
            bad = series[failed_mask].dropna().unique()[:10]
            raise ValueError(
                f"[data_load] Cannot parse {failed_mask.sum()} value(s) in column "
                f"'{series.name}' as epoch timestamp. Bad values: {list(bad)}. "
                "Check the source data or add an explicit format hint in the pipeline config."
            )
        return parsed

    # 4. pandas mixed-format parser (handles ISO+ms/us, most text formats)
    parsed = pd.to_datetime(series, dayfirst=dayfirst, infer_datetime_format=True, errors="coerce")

    # 5. Epoch integers stored as strings (e.g. CSV column "1704067200")
    failed_mask = parsed.isna() & series.notna() & (series.astype(str).str.strip() != "")
    if failed_mask.any():
        try:
            numeric = pd.to_numeric(series[failed_mask], errors="raise")
            unit = "ms" if (numeric.abs() > 2e10).any() else "s"
            parsed = parsed.copy()
            parsed.loc[failed_mask] = pd.to_datetime(numeric, unit=unit, errors="coerce")
            failed_mask = parsed.isna() & series.notna() & (series.astype(str).str.strip() != "")
        except (ValueError, TypeError):
            pass

    # 6. dateutil fallback for named months, vendor formats, non-standard patterns
    if failed_mask.any():
        from dateutil import parser as _du
        def _try_du(v):
            try:
                return _du.parse(str(v), dayfirst=dayfirst)
            except Exception:
                return pd.NaT
        parsed = parsed.copy()
        parsed.loc[failed_mask] = series[failed_mask].apply(_try_du)
        failed_mask = parsed.isna() & series.notna() & (series.astype(str).str.strip() != "")

    # 7. Fail loudly — list the bad values so the user knows exactly what to fix
    if failed_mask.any():
        bad = series[failed_mask].dropna().unique()[:10]
        raise ValueError(
            f"[data_load] Cannot parse {failed_mask.sum()} value(s) in column "
            f"'{series.name}' as date/timestamp. Bad values: {list(bad)}. "
            "Check the source data or add an explicit format hint in the pipeline config."
        )
    return parsed


def _cast_df_types(df: pd.DataFrame, dtype_overrides: dict, date_formats: dict = None) -> pd.DataFrame:
    """Enforce dtype_overrides on a DataFrame, converting each column to the
    requested Python/pandas type so the correct SQL types are used on write.

    Supported dtype strings: int / integer / bigint, float / decimal / numeric,
    bool / boolean, date, timestamp / datetime, text / str / string.

    date_formats: mapping of column name → PostgreSQL format string (hint for
    day-first vs month-first ordering via _universal_to_datetime).
    Sub-second precision and vendor-specific formats are handled automatically.

    RAISES ValueError for date/timestamp columns that contain unparseable values.
    All other type failures are logged as warnings and the column is left as-is.
    """
    date_formats = date_formats or {}
    for raw_col, dtype in dtype_overrides.items():
        col = raw_col.strip()
        if col not in df.columns:
            continue
        try:
            d = dtype.lower()
            if d in ("int", "int64", "integer", "bigint"):
                df[col] = pd.to_numeric(df[col], errors="coerce").astype("Int64")
            elif d in ("float", "float64", "numeric", "decimal"):
                df[col] = pd.to_numeric(df[col], errors="coerce")
            elif d in ("bool", "boolean"):
                df[col] = df[col].map(
                    {"true": True, "false": False, "1": True, "0": False,
                     "yes": True, "no": False, "y": True, "n": False}
                )
            elif d in ("date", "timestamp", "datetime"):
                hint_fmt = date_formats.get(col)
                df[col] = _universal_to_datetime(df[col], hint_fmt=hint_fmt)
            else:
                df[col] = df[col].astype(str)
        except ValueError:
            raise  # date parse failures must bubble up — task should fail loudly
        except Exception as exc:
            logging.warning("[data_load] dtype override failed for '%s' → %s: %s", col, dtype, exc)
    return df


def _auto_set_datestyle(conn, base_sql, column):
    """
    Sample `column` from `base_sql`, inspect the raw text value, and issue the
    appropriate PostgreSQL SET datestyle so subsequent CAST(col AS TIMESTAMP)
    calls succeed for any common date storage format:

        YYYY-MM-DD / YYYY/MM/DD  → ISO (PostgreSQL default, no change needed)
        DD/MM/YYYY, DD-MM-YYYY   → ISO, DMY
        MM/DD/YYYY, MM-DD-YYYY   → ISO, MDY
        ambiguous (both parts ≤ 12) → ISO, DMY  (most common outside the US)

    Non-standard formats (e.g. epoch integers, named months) fall through to
    the existing CAST which already works for those cases.
    """
    import re as _re
    try:
        val = conn.execute(
            text(f"SELECT {column}::text FROM ({base_sql}) _s "
                 f"WHERE {column} IS NOT NULL LIMIT 1")
        ).scalar()
        if not val:
            return
        val = str(val).strip()
        # ISO: YYYY-[/-]MM-[/-]DD — PostgreSQL parses without extra datestyle
        if _re.match(r'^\d{4}[\-/]\d{2}[\-/]\d{2}', val):
            return
        # D{1,2}<sep>M{1,2}<sep>Y{2,4}  or  M<sep>D<sep>Y
        m = _re.match(r'^(\d{1,2})[\-/\.](\d{1,2})[\-/\.](\d{2,4})', val)
        if m:
            a, b = int(m.group(1)), int(m.group(2))
            if a > 12:                              # first part can only be day
                conn.execute(text("SET datestyle = 'ISO, DMY'"))
                logging.info("[data_load] datestyle set to DMY (detected from '%s')", val)
            elif b > 12:                            # second part can only be day
                conn.execute(text("SET datestyle = 'ISO, MDY'"))
                logging.info("[data_load] datestyle set to MDY (detected from '%s')", val)
            else:                                   # ambiguous — default to DMY
                conn.execute(text("SET datestyle = 'ISO, DMY'"))
                logging.info("[data_load] datestyle set to DMY (ambiguous value '%s')", val)
    except Exception as exc:
        logging.warning("[data_load] _auto_set_datestyle: could not detect format: %s", exc)


# ── Universal incremental-column type detection ───────────────────────────────
# Kept for any legacy external references.
_NATIVE_DATE_TYPES = frozenset({
    "date", "timestamp", "datetime",
    "timestamptz", "timestamp with time zone",
})

_INTEGER_DB_KINDS  = frozenset({
    "integer", "int", "int2", "int4", "int8", "bigint", "smallint",
    "serial", "bigserial", "smallserial",
})
_DATETIME_DB_KINDS = frozenset({
    "date", "timestamp", "timestamp without time zone",
    "timestamp with time zone", "timestamptz",
})

# Cache: (conn_id, schema, table, column) → 'integer' | 'datetime' | 'text'
_INCR_TYPE_CACHE: dict = {}


def _probe_incr_col(conn_id: str, schema: str, table: str, column: str) -> str:
    """Auto-detect the DB category of *column* in *schema.table* on *conn_id*.

    Returns ``'integer'``, ``'datetime'``, or ``'text'``.

    Result is cached per (conn_id, schema, table, column) for the lifetime of
    this worker process — one lightweight information_schema query the first
    time, zero cost every subsequent call.

    When the column is not found (view, CTE, subquery-only source) we default
    to ``'text'`` and rely on ``CAST(col AS TIMESTAMP)`` in the generated SQL.
    If the values are genuinely unparseable that CAST fails with a descriptive
    DB error, making the Airflow task stop immediately with an actionable
    message instead of silently loading wrong data.
    """
    key = (conn_id, schema, table, column)
    if key in _INCR_TYPE_CACHE:
        return _INCR_TYPE_CACHE[key]

    kind = "text"
    try:
        hook   = get_hook(conn_id)
        engine = create_engine(hook.get_uri())
        with engine.connect() as conn:
            row = conn.execute(text(
                "SELECT data_type FROM information_schema.columns "
                "WHERE table_schema = :s AND table_name = :t AND column_name = :c "
                "LIMIT 1"
            ), {"s": schema, "t": table, "c": column}).fetchone()
            if row:
                dt = row[0].lower()
                if dt in _INTEGER_DB_KINDS or dt.startswith("int") or "serial" in dt:
                    kind = "integer"
                elif dt in _DATETIME_DB_KINDS or dt.startswith("timestamp") or dt == "date":
                    kind = "datetime"
    except Exception as exc:
        logging.warning(
            "[probe_incr_col] Cannot detect type for %s.%s.%s — defaulting to 'text': %s",
            schema, table, column, exc,
        )

    _INCR_TYPE_CACHE[key] = kind
    logging.info("[probe_incr_col] %s.%s.%s → '%s'", schema, table, column, kind)
    return kind


def _resolve_incr_kind(conn_id: str, schema: str, table: str, column: str) -> str:
    """Return the incremental-column kind, honouring any explicit
    ``incremental_column_datatype`` override in the pipeline config.
    Falls back to DB auto-detection when the override is absent or empty.
    """
    override = (CONFIG["source"].get("incremental_column_datatype") or "").lower()
    if override in ("int", "bigint", "integer", "numeric", "smallint"):
        return "integer"
    if override in ("date", "timestamp", "datetime", "timestamptz",
                    "timestamp with time zone", "timestamp without time zone"):
        return "datetime"
    # No usable override — auto-detect from the actual DB schema.
    return _probe_incr_col(conn_id, schema, table, column)


def _incr_sql_expr(column: str, kind: str, explicit_fmt: str = "") -> str:
    """SQL expression that coerces *column* to a consistently comparable type.

    kind='integer'  → CAST("col" AS BIGINT)
    kind='datetime' → "col"                      (native; already comparable)
    kind='text'     → CAST("col" AS TIMESTAMP)   — handles ISO with ms/us
                       automatically; or TO_TIMESTAMP("col", 'fmt') when
                       *explicit_fmt* is provided for non-ISO text formats
                       like 'DD/MM/YYYY'.

    A CAST that fails produces a genuine DB error that identifies the
    offending value — the load task fails immediately with an actionable
    message, rather than silently loading wrong data.
    """
    if kind == "integer":
        return f'CAST("{column}" AS BIGINT)'
    if kind == "datetime":
        return f'"{column}"'
    # text / unknown default
    if explicit_fmt:
        return f"TO_TIMESTAMP(\"{column}\", '{explicit_fmt}')"
    return f'CAST("{column}" AS TIMESTAMP)'


def _hwm_expressions(incremental_column, incremental_column_datatype, last_loaded,
                     incr_date_format=""):
    """Return ``(order_expr, where_clause)`` for the incremental column.

    Both ``incremental_column_datatype`` and ``incr_date_format`` are
    **optional** — the column type is auto-detected from the source DB when
    absent, and ISO timestamps (including millisecond/microsecond precision)
    are handled automatically via ``CAST(col AS TIMESTAMP)`` with no format
    string required.  Only supply ``incr_date_format`` for genuinely non-ISO
    text formats such as ``'DD/MM/YYYY'``.

    When ``incremental_column_datatype`` is supplied explicitly it is used
    directly and no database round-trip or CONFIG access is needed — making
    the function usable in isolated unit tests and from callers that
    already know the column type.  When it is absent (``None`` / ``""``),
    the type is resolved via ``_resolve_incr_kind`` which reads CONFIG and
    may query the source DB schema.
    """
    _override = (incremental_column_datatype or "").lower()
    if _override in ("int", "bigint", "integer", "numeric", "smallint"):
        kind = "integer"
    elif _override in ("date", "timestamp", "datetime", "timestamptz",
                       "timestamp with time zone", "timestamp without time zone"):
        kind = "datetime"
    elif _override == "text":
        kind = "text"
    else:
        # No usable override — auto-detect from CONFIG / source DB schema.
        src_schema = CONFIG["source"].get("source_table_schema") or ""
        src_table  = CONFIG["source"].get("source_table_name") or ""
        kind       = _resolve_incr_kind(
            CONFIG["source"]["source_db_conn_id"],
            src_schema, src_table,
            incremental_column,
        )

    order_expr = _incr_sql_expr(incremental_column, kind, explicit_fmt=incr_date_format)

    if last_loaded is None:
        where_clause = None
    elif kind == "integer":
        where_clause = f"{order_expr} > {int(last_loaded)}"
    else:
        where_clause = f"{order_expr} > '{last_loaded}'"

    return order_expr, where_clause


def build_batch_temp_sql(base_sql, incremental_column, last_loaded, batch_size, incremental_column_datatype, incr_date_format=""):
    """
    Returns the SQL to populate _etl_batch_tmp.

    last_loaded=None means either full_load=True or first incremental run —
    in both cases load all source rows (no WHERE filter), ordered by HWM if
    incremental_column is set so subsequent runs can pick up from the right place.
    """
    if not incremental_column:
        # No incremental column configured — always a straight full load
        return base_sql

    order_expr, _ = _hwm_expressions(incremental_column, incremental_column_datatype, None, incr_date_format)

    if last_loaded is None:
        # First run or full_load=True: no HWM filter, load everything ordered
        if batch_size and batch_size > 0:
            sql = (
                f"SELECT * FROM ({base_sql}) _src "
                f"ORDER BY {order_expr} "
                f"LIMIT {batch_size}"
            )
        else:
            sql = (
                f"SELECT * FROM ({base_sql}) _src "
                f"ORDER BY {order_expr}"
            )
    else:
        _, where_clause = _hwm_expressions(incremental_column, incremental_column_datatype, last_loaded, incr_date_format)
        if batch_size and batch_size > 0:
            sql = (
                f"SELECT * FROM ({base_sql}) _src "
                f"WHERE {where_clause} "
                f"ORDER BY {order_expr} "
                f"LIMIT {batch_size}"
            )
        else:
            sql = (
                f"SELECT * FROM ({base_sql}) _src "
                f"WHERE {where_clause} "
                f"ORDER BY {order_expr}"
            )

    logging.info("Batch temp SQL: %s", sql)
    return sql


def build_final_select_sql(incremental_column, incremental_column_datatype, incr_date_format="", base_sql=None, batch_size=0, batch_max=None):
    """
    Returns the SQL to read the final boundary-inclusive result from the temp
    table _etl_batch_tmp.

    Why boundary-inclusive:
      When a LIMIT is applied, the batch may cut off mid-tie — i.e. multiple
      source rows share the same HWM value as the last row in the batch, but
      only some of them fit within the LIMIT.  If we stop there, the next run
      uses WHERE order_expr > MAX and skips the tied rows entirely.

      Fix: drop boundary rows from the temp table (rows at exactly batch_max)
      and re-fetch ALL source rows at that value.  This correctly handles:
        • Tie overflow — rows cut off by LIMIT that share batch_max are included
        • Source duplicates — UNION ALL preserves them; target row-count matches source
        • No double-counting — boundary rows come only from the source query, not temp

    The boundary replacement is only applied when a batch_size limit is in use;
    without a limit the temp table already contains all qualifying rows.

    Final ORDER BY ensures Pandas always sees rows in ascending HWM order,
    required for get_last_loaded_value() to advance the watermark correctly.
    """
    if not incremental_column:
        return "SELECT * FROM _etl_batch_tmp"

    order_expr, _ = _hwm_expressions(incremental_column, incremental_column_datatype, None, incr_date_format)

    if batch_size and batch_size > 0 and base_sql and batch_max is not None:
        # Include any rows tied at the batch boundary that the LIMIT cut off.
        # batch_max is pre-fetched as a Python variable (not a nested subquery)
        # so MAX is evaluated once before this SQL is sent to the database.
        # Wrapped in a subquery so ORDER BY applies to the combined UNION result
        # (PostgreSQL does not allow ORDER BY on individual UNION members).
        if isinstance(batch_max, int):
            max_literal = batch_max
        else:
            max_literal = f"'{batch_max}'"
        sql = (
            f"SELECT * FROM ("
            f"SELECT * FROM _etl_batch_tmp WHERE {order_expr} < {max_literal} "
            f"UNION ALL "
            f"SELECT * FROM ({base_sql}) _tie_src "
            f"WHERE {order_expr} = {max_literal}"
            f") _boundary_inclusive "
            f"ORDER BY {order_expr}"
        )
    else:
        sql = (
            f"SELECT * FROM _etl_batch_tmp "
            f"ORDER BY {order_expr}"
        )
    logging.info("Final select SQL: %s", sql)
    return sql


def get_last_loaded_value():
    """Return the current HWM from the target table, or ``None`` on first run.

    The incremental column type is **auto-detected** from the target DB — no
    need to set ``incremental_column_datatype`` in the pipeline config.

    If a stored value cannot be cast to a comparable type (e.g. the target
    column contains garbage text) the query fails with a descriptive DB error,
    causing the Airflow task to stop immediately with an actionable message
    rather than silently advancing a wrong watermark.
    """
    if CONFIG["source"].get("full_load", False):
        logging.info("get_last_loaded_value: full_load=True — skipping HWM query.")
        return None

    incremental_column = CONFIG["source"]["incremental_column"]
    if not incremental_column:
        return None

    incr_date_fmt = CONFIG["source"].get("incremental_column_date_format", "") or ""
    schema = CONFIG["target"]["target_table_schema"]
    table  = CONFIG["target"]["target_table_name"]

    target_hook   = get_hook(CONFIG["target"]["target_db_conn_id"])
    target_engine = create_engine(target_hook.get_uri())

    # Detect kind from the *target* column (create_target may have stored a
    # TEXT source column as TIMESTAMP — either way MAX() returns the right type).
    kind = _resolve_incr_kind(
        CONFIG["target"]["target_db_conn_id"], schema, table, incremental_column
    )
    # IMPORTANT: never pass the user-supplied incr_date_fmt to the HWM query.
    # TO_TIMESTAMP("col", 'YYYY-MM-DD') applied to data stored as 'DD-MM-YYYY'
    # reads digits greedily across separators and produces wrong years (e.g.
    # '21-04-2026' → year 2104). Instead always use bare CAST and let
    # _auto_set_datestyle detect the actual format from a sample row first.
    cast_expr = _incr_sql_expr(incremental_column, kind, explicit_fmt="")

    # For date/timestamp/text columns cap the MAX to NOW() + 1 year so that stray
    # far-future rows (e.g. year 2104 data-entry errors) never become the HWM
    # and freeze the pipeline at a watermark no real data will ever exceed.
    # Integer HWM columns are left uncapped — their range is application-defined.
    # Works for all non-integer kinds: cast_expr already coerces text → TIMESTAMP.
    future_guard = (
        f" WHERE {cast_expr} <= NOW() + INTERVAL '1 year'"
        if kind != "integer"
        else ""
    )

    try:
        with target_engine.connect() as conn:
            # For text-stored date columns, detect the actual format from a
            # sample row so CAST("col" AS TIMESTAMP) uses the correct datestyle.
            # This prevents TO_TIMESTAMP format mismatches (e.g. 'DD-MM-YYYY'
            # data with a 'YYYY-MM-DD' hint producing wrong years like 2104).
            if kind == "text":
                _auto_set_datestyle(
                    conn,
                    f'SELECT * FROM "{schema}"."{table}"',
                    f'"{incremental_column}"',
                )
            row = conn.execute(
                text(
                    f'SELECT MAX({cast_expr}) AS max_val '
                    f'FROM "{schema}"."{table}"{future_guard}'
                )
            ).fetchone()
            value = row[0] if row else None

        if value is None:
            logging.info(
                "get_last_loaded_value: %s.%s is empty (or all rows are future-dated) "
                "— first incremental load.",
                schema, table,
            )
        else:
            logging.info("get_last_loaded_value: HWM = %s (%s)", value, type(value).__name__)
            # Warn loudly if even the capped HWM is unexpectedly far in the future.
            from datetime import date as _date, datetime as _dt
            _today = _dt.utcnow().date()
            _val_date = value.date() if hasattr(value, "date") else (value if isinstance(value, _date) else None)
            if _val_date and (_val_date.year - _today.year) > 1:
                logging.warning(
                    "get_last_loaded_value: HWM %s is more than 1 year in the future "
                    "— check %s.%s for bad dates (e.g. year %s data-entry errors).",
                    value, schema, table, _val_date.year,
                )
        return value
    except Exception as e:
        logging.warning(
            "get_last_loaded_value: could not read HWM from %s.%s (%s) — treating as first load.",
            schema, table, e,
        )
        return None



default_args = {
    "owner": "airflow",
    "start_date": datetime.strptime(CONFIG["start_date"], "%Y-%m-%d"),
    "retries": 3,
    "retry_delay": timedelta(seconds=30),
    "depends_on_past": False,
}

dag = DAG(
    dag_id=CONFIG["dag_id"],
    default_args=default_args,
    schedule_interval=CONFIG["schedule_interval"],
    tags=CONFIG["tags"],
