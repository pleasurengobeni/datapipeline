_ENGINE_CACHE: dict = {}


def _get_engine(conn_id):
    if conn_id in _ENGINE_CACHE:
        return _ENGINE_CACHE[conn_id]
    from airflow.hooks.base import BaseHook
    from sqlalchemy import create_engine
    conn = BaseHook.get_connection(conn_id)
    port = conn.port or 5432
    pwd  = quote_plus(str(conn.password or ""))
    url  = f"postgresql+psycopg2://{conn.login}:{pwd}@{conn.host}:{port}/{conn.schema}"
    _ENGINE_CACHE[conn_id] = create_engine(url, pool_pre_ping=True)
    return _ENGINE_CACHE[conn_id]


def _pg_copy_df(df, schema, table, engine):
    import io
    buf = io.StringIO()
    df.to_csv(buf, index=False, na_rep="")
    buf.seek(0)
    col_sql = ", ".join(f'"{c}"' for c in df.columns)
    raw_conn = engine.raw_connection()
    try:
        cur = raw_conn.cursor()
        cur.copy_expert(
            f'COPY "{schema}"."{table}" ({col_sql}) FROM STDIN WITH (FORMAT CSV, HEADER TRUE)',
            buf,
        )
        cur.close()
        raw_conn.commit()
    finally:
        raw_conn.close()


def _ensure_schema(conn_id, schema):
    from sqlalchemy import text
    engine = _get_engine(conn_id)
    with engine.begin() as conn:
        conn.execute(text(f'CREATE SCHEMA IF NOT EXISTS "{schema}"'))


def _ensure_table_from_df(df, conn_id, schema, table):
    """Create table from DataFrame column structure if it does not exist yet."""
    from sqlalchemy import text
    engine = _get_engine(conn_id)
    col_defs = ", ".join(f'"{c}" TEXT' for c in df.columns)
    with engine.begin() as conn:
        conn.execute(text(
            f'CREATE TABLE IF NOT EXISTS "{schema}"."{table}" ({col_defs})'
        ))
        # Add any columns that are in the DataFrame but missing from the table
        # (handles schema evolution between runs).
        for col in df.columns:
            conn.execute(text(
                f'ALTER TABLE "{schema}"."{table}" '
                f'ADD COLUMN IF NOT EXISTS "{col}" TEXT'
            ))


def _ensure_registry_table(conn):
    from sqlalchemy import text
    conn.execute(text("CREATE SCHEMA IF NOT EXISTS pipeline"))
    conn.execute(text("""
        CREATE TABLE IF NOT EXISTS pipeline.file_load_registry (
            id              SERIAL PRIMARY KEY,
            dag_id          TEXT,
            target_schema   TEXT,
            target_table    TEXT,
            file_name       TEXT,
            file_path       TEXT,
            file_checksum   TEXT,
            file_size_bytes BIGINT,
            rows_loaded     BIGINT,
            run_id          TEXT,
            loaded_at       TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
            archived_to     TEXT,
            archived_at     TIMESTAMP WITH TIME ZONE
        )
    """))
    conn.execute(text("""
        CREATE UNIQUE INDEX IF NOT EXISTS ux_hybrid_registry_checksum
            ON pipeline.file_load_registry (target_schema, target_table, file_checksum)
    """))


def _checksum_registered(schema, table, checksum):
    from sqlalchemy import text
    engine = _get_engine(CONFIG["raw"]["conn_id"])
    with engine.begin() as conn:
        _ensure_registry_table(conn)
    with engine.connect() as conn:
        row = conn.execute(
            text("""
                SELECT 1 FROM pipeline.file_load_registry
                WHERE target_schema = :s AND target_table = :t AND file_checksum = :c
                LIMIT 1
            """),
            {"s": schema, "t": table, "c": checksum},
        )
        return row.fetchone() is not None


