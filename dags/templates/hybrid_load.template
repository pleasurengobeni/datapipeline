def load_config(dag_name):
    config_path = Variable.get(
        "config_path", default_var=os.path.join(os.getcwd(), "dags", "config")
    )
    pattern = os.path.join(config_path, "**", f"*{dag_name.lower()}*.json")
    matches = glob.glob(pattern, recursive=True)
    if not matches:
        raise FileNotFoundError(
            f"Config file for '{dag_name}' not found under '{config_path}'"
        )
    config = read_json_file(matches[0])
    env = Variable.get("environment", "dev")

    source_cfg = config["source"].get(env, config["source"])
    target_cfg = config["target"].get(env, config["target"])

    # ── Source ───────────────────────────────────────────────────────────
    source_type = config.get("source_type", "file")
    data_dump_base = Variable.get("data_dump", "/opt/airflow/data_dump")
    watch_path   = source_cfg.get("watch_path")  or os.path.join(data_dump_base, "incoming")
    archive_path = source_cfg.get("archive_path") or os.path.join(data_dump_base, "archive")

    # ── Raw / Refined schema + table — FIXED convention, not configurable ──
    # Raw is a permanent, append-only landing zone shared by every hybrid DAG
    # on a DB: raw.<target_schema>_<target_table>_raw. It is never truncated,
    # so it doubles as a durable audit trail a target table can always be
    # rebuilt from without re-requesting the original source file.
    #
    # Refined lives in a shared "pipeline" schema (also table-name-prefixed
    # with the target schema, since many different targets share this one
    # schema): pipeline.<target_schema>_<target_table>_refined. It stays
    # transient (fully rewritten every run) — cleaning runs here, never
    # against raw.
    #
    # This used to be configurable via top-level "raw_schema"/"refined_schema"
    # keys, but a bug meant they were never actually read (this function only
    # ever looked for a nested {"raw": {...}} object that no config or the
    # web UI ever wrote) — every DAG already silently used a fixed location
    # regardless. Any config still carrying those dead keys is just ignored.
    if "raw_schema" in config or "refined_schema" in config:
        logging.warning(
            "[hybrid] '%s' config has raw_schema/refined_schema keys — these "
            "are no longer read (the raw/refined location is now fixed, not "
            "configurable). Safe to delete from the config file.", dag_name
        )

    tgt_schema_name = (
        target_cfg.get("target_schema")
        or target_cfg.get("target_table_schema")
    )
    base_name = target_cfg.get("target_table") or target_cfg.get("target_table_name", "unknown")
    transit_prefix  = f"{tgt_schema_name}_{base_name}"

    raw_schema      = "raw"
    raw_table       = f"{transit_prefix}_raw"
    refined_schema  = "pipeline"
    refined_table   = f"{transit_prefix}_refined"
    # Raw and refined live in the same DB as the DW target.
    rw_conn_id = target_cfg.get("target_db_conn_id")

    # ── Cleaning block — None means pass-through copy (no transforms) ────
    # In the config JSON set  "cleaning": null  (or omit the key) to skip
    # cleaning and just copy raw → refined as-is.
    # To enable cleaning add:
    #   "cleaning": {
    #       "sql_queries": ["UPDATE raw.tbl_raw SET col = TRIM(col)", ...],
    #       "script_path": "customer_clean.py",          ← relative to cleaning_files_path
    #       "functions":   ["run_sql_queries", "update_provinces_with_fuzzy_matching"]
    #   }
    cleaning = config.get("cleaning")

    # ── api source ── (only populated/used when source_type == "api"; every
    # key defaults harmlessly to empty for file/db configs, same as the file
    # keys already default harmlessly for a db config and vice versa)
    auth_cfg            = source_cfg.get("auth", {}) or {}
    response_format_cfg = source_cfg.get("response_format", {}) or {}
    pagination_cfg       = source_cfg.get("pagination", {}) or {}
    hwm_cfg              = source_cfg.get("hwm") or {}

    return {
        "dag_id":            config.get("dag_id", f"HYBRID_{dag_name}"),
        "schedule_interval": config.get("schedule_interval"),
        "start_date":        config.get("start_date", "2023-01-01"),
        "source_type":       source_type,
        "source": {
            # ── file source ──
            "watch_path":             watch_path,
            "file_name":              source_cfg.get("file_name", ""),
            "file_format":            source_cfg.get("file_format", "csv"),
            "delimiter":              source_cfg.get("delimiter", ","),
            "encoding":               source_cfg.get("encoding", "auto"),
            "has_header":             source_cfg.get("has_header", True),
            "null_values":            source_cfg.get("null_values", ["", "NULL", "null", "None", "NA", "N/A", "n/a", "#N/A"]),
            "date_columns":           source_cfg.get("date_columns", []),
            "dtype_overrides":        source_cfg.get("dtype_overrides", {}),
            "dtype_override_formats": source_cfg.get("dtype_override_formats", {}),
            "skip_rows":              source_cfg.get("skip_rows", 0),
            "archive_path":           archive_path,
            "archive_retention_days": int(source_cfg.get("archive_retention_days", 30)),
            # ── db source ──
            "source_db_conn_id":   source_cfg.get("source_db_conn_id"),
            "source_table_schema": source_cfg.get("source_table_schema"),
            "source_table_name":   source_cfg.get("source_table_name"),
            "sql_file":            source_cfg.get("sql_file"),
            "full_load":           source_cfg.get("full_load", True),
            "batch_size":          source_cfg.get("batch_size"),
            # ── api source ──
            # url_mode "full": the whole request URL (query string, token/key
            # embedded and all) is stored as one encrypted secret rather than
            # split into base_url + a separate auth mechanism — see
            # fetch_api_pages(). base_url/data_endpoint/auth below are simply
            # unused in that mode.
            "url_mode":        source_cfg.get("url_mode", "separate"),
            "full_url_enc":    source_cfg.get("full_url_enc", ""),
            "base_url":        (source_cfg.get("base_url") or "").rstrip("/"),
            "data_endpoint":   source_cfg.get("data_endpoint", ""),
            "http_method":     (source_cfg.get("http_method") or "GET").upper(),
