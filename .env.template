# -----------------------------------------------------------------------------
# Web UI (Flask — port 5001)
# -----------------------------------------------------------------------------
WEBUI_SECRET_KEY=${WEBUI_SECRET_KEY}
WEBUI_ADMIN_USER=${WEBUI_ADMIN_USER}
WEBUI_ADMIN_PASS=${WEBUI_ADMIN_PASS}
# Encrypts API-job secrets (API keys/tokens/login passwords) at rest in
# dags/config/**/*.json. Generate ONCE with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this key invalidates every previously-encrypted API credential in
# every saved API job config — there is no re-encryption/rotation path yet.
WEBUI_FERNET_KEY=${WEBUI_FERNET_KEY}

# -----------------------------------------------------------------------------
# AI API keys (optional — used by web-ui /api/suggest-descriptions)
# Set these in ~/.airflow then re-run install.sh (server) or restart compose (local)
# -----------------------------------------------------------------------------
GOOGLE_AI_API_KEY=${GOOGLE_AI_API_KEY}
GROQ_API_KEY=${GROQ_API_KEY}
MISTRAL_API_KEY=${MISTRAL_API_KEY}
DEEPSEEK_API_KEY=${DEEPSEEK_API_KEY}
OPENROUTER_API_KEY=${OPENROUTER_API_KEY}
CEREBRAS_API_KEY=${CEREBRAS_API_KEY}
SAMBANOVA_API_KEY=${SAMBANOVA_API_KEY}

